# Hyperliquid API Configuration
HYPERLIQUID_API_KEY=your_api_key_here
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_TESTNET=false

# LLM API Configuration

# OpenRouter (Multi-LLM access - GPT-5, DeepSeek, Grok, Claude, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_LLM_MODEL=deepseek/deepseek-chat

# DeepSeek Direct API (optional - use OpenRouter instead)
DEEPSEEK_API_KEY=your_deepseek_or_netmind_api_key_here
DEEPSEEK_USE_NETMIND=true  # Use NetMind.ai for up to $100k free credits
DEEPSEEK_MODEL=deepseek-chat

# TAAPI.io (Technical Indicators - from Gajesh2007/ai-trading-agent)
TAAPI_API_KEY=your_taapi_api_key_here

# Nansen MCP Configuration
NANSEN_API_KEY=your_nansen_api_key_here
NANSEN_MCP_SERVER_URL=http://localhost:3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hyperliquid_trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=your_postgres_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Risk Management
ACTIVE_CAPITAL=15000
MAX_DAILY_LOSS=750
MAX_DRAWDOWN=3000
DEFAULT_LEVERAGE=4
MAX_LEVERAGE=8

# Trading Configuration
PRIMARY_PAIRS=SOL,HYPE,DOGE
MAX_CONCURRENT_POSITIONS=4
POSITION_SIZE_PERCENT=18

# Monitoring & Alerts
DISCORD_WEBHOOK_URL=your_discord_webhook_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# System Configuration
LOG_LEVEL=INFO
ENABLE_PAPER_TRADING=true
ENABLE_AI_LEARNING=false
AWS_REGION=ap-northeast-1

# Feature Flags

# Multi-Agent System (TauricResearch framework)
ENABLE_MULTI_AGENT=true  # Specialized agents (Technical, Nansen, Trader)
USE_OPENROUTER=true  # Use OpenRouter for multi-LLM access

# Individual Strategies
ENABLE_DEEPSEEK_STRATEGY=true  # HIGHEST PRIORITY - DeepSeek won Alpha Arena!
ENABLE_ORDERBOOK_STRATEGY=true
ENABLE_VOLUME_PROFILE_STRATEGY=false  # Disabled initially
ENABLE_SMART_MOMENTUM_STRATEGY=true

# Deployment Configuration
DEPLOYMENT_WEEK=1  # Progressive rollout (1-5)
